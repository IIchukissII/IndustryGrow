#
# Deployment configuration — copy to erp/.env and edit. See deploy/README.md.
#
# THIS FILE IS A TEMPLATE AND HOLDS NO SECRETS. The copy you make DOES: it holds
# the database password and the warehouse keys, so `chmod 600` it and keep it off
# the repository. `.env` is gitignored.

# --- Database (REQUIRED — compose refuses to start without these) ------------
# mongo:7 runs with authentication DISABLED unless root credentials are present
# at first start, and this database is the pre-cloud system of record holding
# operator-private production data (ADR-0021 d2/d14). There is deliberately no
# default: a default password would be worse than none, because it would work.
#
# Set these BEFORE the first `docker compose up`. The admin user is created only
# on an empty data volume; adding credentials later does nothing.
ERP_MONGO_USER=""
ERP_MONGO_PASSWORD=""
ERP_MONGO_DB="industrygrow_erp"

# --- Warehouse (S3-compatible object store, ADR-0017 d15) --------------------
# Cloudflare R2, AWS S3, or an existing MinIO — all S3-compatible, so this is a
# configuration choice rather than a code one. Leave the endpoint empty to use the
# bundled MinIO (`--profile standalone`), which is a development convenience.
ERP_WAREHOUSE_ENDPOINT=""
ERP_WAREHOUSE_BUCKET="industrygrow"
ERP_WAREHOUSE_ACCESS_KEY=""
ERP_WAREHOUSE_SECRET_KEY=""
ERP_WAREHOUSE_REGION="auto"

# --- Operator identity -------------------------------------------------------
# Shown in the console and carried as the tenant dimension the schema keeps even
# while operating single-tenant (ADR-0021 d16). The UUID is what stage 11 maps to
# an IndustryFlow tenant; generate one now (`uuidgen`) rather than later.
ERP_OPERATOR_NAME=""
ERP_OPERATOR_UUID=""

# --- TLS ---------------------------------------------------------------------
# Directory holding server-chain.crt, server.key and operator-root.crt, issued by
# the operator CA (pki/README.md). NOT the operator root KEY — that does not
# belong on an online host (ADR-0024 d5).
ERP_TLS_DIR="./deploy/mtls/certs"

# --- Ports -------------------------------------------------------------------
# 443 is the one most likely already taken on a host that runs anything else.
# Check with: ss -tlnp | grep -E ':(443|8443)\b'
ERP_HTTPS_PORT="443"    # console + token API (server TLS only)
ERP_MTLS_PORT="8443"    # the gateway channel (client certificate required)

# The app's own port, published only when running WITHOUT the mTLS overlay. Bound
# to localhost by default: a caller reaching it directly bypasses certificate
# verification, and the overlay removes it entirely.
ERP_BIND="127.0.0.1"
ERP_PORT="8021"

# The bundled standalone MinIO (development only). 9000 is the S3 default, so it
# collides on any host already running an object store.
MINIO_BIND="127.0.0.1"
MINIO_PORT="9000"
MINIO_CONSOLE_PORT="9001"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
