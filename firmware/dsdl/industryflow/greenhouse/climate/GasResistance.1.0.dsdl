# Metal-oxide gas-sensor resistance -- the VOC trend signal of M01 spec 6.4.
# Minted because the OpenCyphal standard set has no electrical-resistance sample
# type (ADR-0005 d2).
#
# Deliberately NOT an air-quality index. IAQ, CO2-equivalent, bVOC-equivalent
# and gas-scan classification are outputs of Bosch's closed-source BSEC, which
# is incompatible with the AGPL reference firmware (ADR-0002 d5), so this
# subject carries the raw sensor-API resistance and nothing derived from it.
# Absolute values are meaningless; the quantity is a trend against a per-device
# baseline, and the baseline moves with hotplate ageing (spec 6.4). CO2 is
# measured by the SCD41 on its own subject, never estimated from this one.
#
# Scalar, one hotplate setpoint per cycle.
#
# SUPERSEDED by 2.0, which carries the sweep. Two expectations recorded here did
# not survive: a vector needed a MAJOR bump, because an extent must be shared
# across a major version and 32 bytes does not hold one; and it needed no
# parallel mode, because consecutive forced-mode shots at successive setpoints
# produce the same R(T) on the spec 4.2 alternative as on the BME688, so
# variant_id never reached the critical path (spec O-49).
#
# Retained: a released type is not withdrawn. Nothing publishes it.
uavcan.time.SynchronizedTimestamp.1.0 timestamp
float32 ohm              # heater-plate resistance at the setpoint below
uint16 heater_celsius    # hotplate target this cycle, for trend comparability
bool valid               # gas conversion completed AND the heater reached stability
@extent 32 * 8
