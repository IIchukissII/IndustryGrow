#
# fail2ban — ADR-0004 rev 1 decision 3 (strict thresholds on SSH).
# Installed to /etc/fail2ban/jail.local
#
# Trixie's fail2ban reads the systemd journal directly (no /var/log/auth.log
# needed), which fits the journald-only logging posture (ADR-0004 rev 1 d11).

[DEFAULT]
backend         = systemd
# Never ban the management LAN (ADR-0004 d3, as amended). Rendered by
# provision.sh from the management NICs' own link routes; IGROW_F2B_IGNOREIP
# adds sources the derivation cannot see. Bans are persisted and re-applied on
# start, and escalate x2 to a week, so without this a mistyped key attempt
# takes the operator off their own gateway across reboots.
ignoreip        = 127.0.0.1/8 ::1
bantime         = 1h
findtime        = 10m
maxretry        = 3
# Escalating bans for repeat offenders — strict per ADR-0004 d3.
bantime.increment = true
bantime.factor    = 2
bantime.maxtime   = 1w

[sshd]
enabled  = true
mode     = aggressive
maxretry = 3
bantime  = 1h
