#!/usr/sbin/nft -f
# SPDX-FileCopyrightText: 2026 The IndustryGrow contributors
# SPDX-License-Identifier: CC-BY-SA-4.0
#
# Gateway firewall — ADR-0004 rev 1 decisions 5 and 6.
# Rendered by provision.sh (the two `define` lines below are substituted from
# /etc/industrygrow/gateway.env) and installed as /etc/nftables.conf.
#
# INBOUND: default-deny, except SSH on the LAN-facing management interfaces. The
#   gateway is not a server to the LAN (ADR-0004 rev 1 decision 6: no service
#   exposed to the LAN). SSH is allowed on every management NIC the box may be
#   reached over — Wi-Fi and wired alike — not one baked interface, so moving the
#   cable or falling back to Wi-Fi never locks the operator out (ADR-0004 d5, as
#   amended). The CAN interfaces (can*/vcan*) are deliberately NOT in the set.
#
# OUTBOUND: OPEN at bring-up, per ADR-0004 rev 1 decision 19, which records that
#   decision 5's outbound half binds only from roadmap stage 11. IndustryFlow does
#   not exist yet (ADR-0020 context) and apt/pip need egress to provision. The
#   production target is two named destinations, not one: the IndustryFlow endpoint
#   and the operator ERP the profile pull calls (ADR-0015 d5, ADR-0022 d2/d8). The
#   lock-down is marked below; it is NOT enabled by this automation.

flush ruleset

define SSH_IFACES = { "wlan0", "eth0", "end0" }
define SSH_PORT = 22

table inet industrygrow {
    chain input {
        type filter hook input priority 0; policy drop;

        ct state established,related accept
        ct state invalid drop
        iif "lo" accept

        # ICMP / ICMPv6 — keep diagnostics and PMTUD working.
        ip protocol icmp accept
        ip6 nexthdr ipv6-icmp accept

        # SSH on the LAN-facing management interfaces (bring-up posture; ADR-0004
        # d2/d5/d6). Production posture (ADR-0004 d2) keeps sshd OFF by default —
        # see Manual. The set is rendered by provision.sh; it always includes the
        # live default-route interface, so it is lockout-safe on any path.
        iifname $SSH_IFACES tcp dport $SSH_PORT ct state new accept
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
    }

    chain output {
        # BRING-UP: egress open (apt/pip/DNS/NTP need it).
        type filter hook output priority 0; policy accept;

        # ===== PRODUCTION TARGET (ADR-0004 rev 1 decisions 5 and 19) =====
        # When IndustryFlow exists, flip `policy accept` -> `policy drop` and allow
        # only the minimum egress, e.g.:
        #     ct state established,related accept
        #     oif "lo" accept
        #     udp dport 53 accept                       # DNS
        #     ip daddr <industryflow-ip> tcp dport 443 accept   # mTLS upload
        #     ip daddr <erp-ip> tcp dport <erp-port> accept      # mTLS profile pull (IGROW_ERP_URL)
        # DO NOT enable now: no endpoint exists and provisioning needs egress.
    }
}
