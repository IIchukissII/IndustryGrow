#
# IndustryGrow gateway provisioning configuration — TEMPLATE.
#
# Copy to gateway.env and edit, OR let provision.sh install this as
# /etc/industrygrow/gateway.env on first run (it will not overwrite your edits).
#
# THIS FILE CONTAINS NO SECRETS. Per-instance secrets — login/sudo password, SSH
# private keys, the ATECC608 binding and gateway certificate — live OFF-REPO in a
# secret manager / IndustryFlow (ADR-0017 two-homes deferred item; ADR-0019 d2:
# the gateway's instance key is the vendor serial + the ATECC-bound cert, never
# committed here). The automation authenticates only by the SSH key already
# installed by the Imager.
#
# The identity itself is not configured here and has no variable below. It is
# provisioned in a later phase by provision_identity.py (see
# store/SP0004-M-atecc-provisioning.md), which installs the certificate chain into
# /etc/industrygrow/pki/ — and installs no private key, because the private key is
# inside the ATECC and cannot be exported (ADR-0007 d1).

# --- Network / SSH -----------------------------------------------------------
# SSH is allowed on the SET of LAN-facing management interfaces (ADR-0004 d5/d6),
# so moving the cable or falling back to Wi-Fi never locks you out. The rendered
# set is: IGROW_SSH_IFACES, plus IGROW_LAN_IFACE, plus the live default-route
# interface (always unioned in — the current path can never be excluded).
#
# IGROW_SSH_IFACES: space-separated management NICs SSH may arrive on. The default
# covers every reach path — Wi-Fi (wlan0), USB/legacy Ethernet (eth0), Pi 5
# onboard (end0). CAN interfaces (can*/vcan*) are never in this set.
IGROW_SSH_IFACES="wlan0 eth0 end0"
# IGROW_LAN_IFACE: optional extra/primary management iface. LEAVE EMPTY to auto-
# detect the default-route interface (used for logging and always added to the
# set above). Set only to force an extra interface not covered by the default.
IGROW_LAN_IFACE=""
IGROW_SSH_PORT="22"
# IGROW_F2B_IGNOREIP: sources fail2ban must never ban (ADR-0004 d3, as amended).
# LEAVE EMPTY to derive it — loopback plus the directly-attached subnet of each
# management NIC above, read from the kernel's own link routes at provision time.
# Set only to add a source the derivation cannot see (a jump host on another
# subnet, a VPN pool). Strict thresholds still apply to every other source.
IGROW_F2B_IGNOREIP=""

# --- CAN ---------------------------------------------------------------------
# IGROW_CAN_IFACE selects the interface the automation brings up (can-up.sh):
#   vcan0  — bring-up validation, software loopback, NO bit rate.
#   can0   — physical bus (after the HAT + overlay exist), brought up at the rate
#            below.
# IGROW_CAN_BITRATE is the single home for the bus rate. It is FIXED at 500000
# (500 kbit/s classic CAN, ADR-0002 rev 3 d8 — a single fixed rate, no
# negotiation); do not change it without an ADR amendment. It applies to a
# physical canN only; vcan ignores it.
IGROW_CAN_IFACE="vcan0"
IGROW_CAN_BITRATE="500000"

# IGROW_CYPHAL_NODE_ID is the gateway's own Cyphal Node-ID, used by the bus time
# master (ADR-0002 rev 3 d11). It MUST be the lowest Node-ID on the bus: the
# dominant time master is elected by lowest Node-ID, and the node range starts at
# 96 (see the module specs). 1 leaves room below it and is the default; changing
# it to a value inside the node range would break election, not merely rename it.
IGROW_CYPHAL_NODE_ID="1"

# Physical MCP2515 HAT overlay — OPTIONAL, flag-gated, OFF by default.
# Set IGROW_CAN_HAT=mcp2515 to have provision.sh manage the device-tree overlay
# in /boot/firmware/config.txt (declarative + idempotent). HAT-specific and needs
# a REBOOT before can0/can1 appear. The oscillator MUST match the crystal printed
# on the board; the INT GPIOs are board-specific. Leave IGROW_CAN1_INT empty for a
# single-channel HAT. Validated: Waveshare 2-CH Isolated CAN HAT = 16 MHz, can0
# INT23 (HAT INT0 -> GPIO23), can1 INT25 (HAT INT1 -> GPIO25). Both channels pass
# MCP2515 internal loopback with these pins.
# IGROW_CAN_HAT_SPI_MAXFREQ caps the MCP2515 SPI clock. REQUIRED on the Pi 5 (RP1):
# the default clock is too fast and corrupts the register reads that clear the INT
# flag, so the interrupt storms and the driver never delivers received frames — RX
# is dead while init/TX still look fine (MCP2515 internal loopback exposes it). 1 MHz
# is reliable; set empty to use the driver default (fine on Pi 4 / older).
# BRING-UP NOTE (Waveshare 2-CH Isolated HAT): the kernel interface names are CROSSED
# vs the silkscreened screw-terminal blocks — interface `can0` is the HAT's *CAN1*
# block (spi0.1), interface `can1` is the HAT's *CAN0* block (spi0.0). So wire the bus
# to the CAN1 block and use `can0`. (An earlier "CAN0 block dead" symptom on gbox-dev
# was NOT a dead channel — it was the wrong INT GPIOs; interface `can1` never got its
# interrupt. Fixed by the 23/25 mapping above.) Still confirm a channel with `candump`
# (against a live node) before relying on it — MCP2515 internal loopback only proves
# the controller, not the transceiver on the wire. The isolated side also needs its CAN GND (the terminal-
# block "G") tied to the bus ground; skipping it works on a short bench bus but
# accumulates errors — wire G for a deployed run.
IGROW_CAN_HAT="off"          # off | mcp2515
IGROW_CAN_HAT_OSC="16000000"
IGROW_CAN0_INT="23"          # Waveshare 2-CH Isolated HAT: INT0 -> GPIO23
IGROW_CAN1_INT="25"          # Waveshare 2-CH Isolated HAT: INT1 -> GPIO25; empty = single-channel (can0 only)
IGROW_CAN_HAT_SPI_MAXFREQ="1000000"  # Hz; REQUIRED on Pi 5. empty = driver default

# --- Unattended-upgrades reboot window (ADR-0004 d4) -------------------------
# FLAGGED: ADR-0004 d4 schedules the reboot "during photoperiod-off hours", which
# is UNDEFINED before a cultivation profile exists. LEAVE EMPTY to keep automatic
# reboot DISABLED (default). Set to "HH:MM" only once the photoperiod is known.
IGROW_UNATTENDED_REBOOT_TIME=""

# --- Local persistent store (ADR-0020) ---------------------------------------
# OFF by default: on the SD bring-up card the gateway is RAM-only (ADR-0004 d8-9;
# ADR-0020 d10 allows bare SD only for no-local-store deployments). Set to "on"
# ONLY on an SSD/NVMe medium, where ADR-0020 d2/d3 permits the bounded best-effort
# store-and-forward buffer. With it off the telemetry consumer still decodes and
# keeps the live working set (ADR-0020 d6); nothing is written and `t_store` is
# absent rather than zero (ADR-0004 d18).
IGROW_PERSISTENT_BUFFER="off"

# SQLite file under the service StateDirectory (/var/lib/industrygrow).
IGROW_TELEMETRY_DB=""

# Retention is a TIME bound, not a capacity bound (ADR-0020 d2); eviction is
# oldest-first and runs on the sweep interval.
IGROW_RETENTION_DAYS="7"
IGROW_RETENTION_SWEEP_S="3600"

# Write batching, and how often the consumer summarises each node to the journal.
IGROW_COMMIT_INTERVAL_S="5"
IGROW_COMMIT_ROWS="200"
IGROW_REPORT_S="60"
IGROW_HEARTBEAT_KEEPALIVE_S="300"

# --- Acquisition-to-receipt latency validity (ADR-0004 d21) ------------------
# `t_rx - t_acq` spans two machines, so it is recorded as ABSENT while the host
# clock is unsynchronized or was stepped inside the settling window. STEP_MS is
# what counts as a step in the CLOCK_REALTIME/CLOCK_MONOTONIC difference;
# SETTLE_S is the disciplining interval — about a minute on the reference
# gateway while systemd-timesyncd corrected a 10 ms RTC offset.
IGROW_CLOCK_STEP_MS="5"
IGROW_CLOCK_SETTLE_S="60"

# --- DSDL namespaces compiled at provisioning (ADR-0005 d10) -----------------
# Space-separated root namespace directories. Empty = the repo checkout
# provision.sh runs from (firmware/third_party/public_regulated_data_types/uavcan
# and firmware/dsdl/industryflow). Provisioning-time only; the service reads the
# compiled packages from /opt/industrygrow/dsdl.
IGROW_DSDL_ROOTS=""

# --- Profile pull (ADR-0015 d5-d7, ADR-0025) ---------------------------------
# The ERP the gateway pulls its active cultivation profile from, over the mTLS
# channel (ADR-0022 d2/d8). Scheme + host + optional port, no path — the client
# appends /api/v1/gateway/active-profile.
#
# LEAVE EMPTY to keep the pull DISABLED (default). provision.sh installs
# industrygrow-profile-pull.timer either way but does not start it without this,
# because a timer failing every minute against an unset URL teaches an operator to
# ignore the journal.
#
# Before starting it, the gateway needs three things in /etc/industrygrow/pki/:
#   gateway-chain.crt    its identity (provision_identity.py — SP0004-M-atecc-provisioning)
#   operator-root.crt    the trust anchor for the ERP's server certificate
#   profile-verify.pub   the operator's profile-verification key (signing/README.md)
# Without the last one nothing is applied at all: ADR-0015 d7 requires verification
# before application, so a missing key is fail-closed, not a check to skip.
IGROW_ERP_URL=""

# Poll interval in seconds for `profile_client.py serve`. The systemd TIMER is the
# production path and carries its own cadence (OnUnitInactiveSec) — change it there
# with `systemctl edit industrygrow-profile-pull.timer`. This applies only to the
# in-process loop, for a host without timers. ADR-0015 d5's default is 60.
IGROW_PROFILE_INTERVAL="60"
IGROW_PROFILE_TIMEOUT="20"

# --- Node firmware update (ADR-0029 d14-d17) ---------------------------------
# The same ERP and the same mTLS identity as the profile pull above: the client
# appends /api/v1/gateway/firmware to IGROW_ERP_URL. There is no separate enable
# flag, and two things gate a node being written:
#   IGROW_ERP_URL           empty here, and provision.sh leaves the timer stopped.
#   the release selection    made by an operator in the console (ADR-0029 d16).
#                            With none recorded the pass ends 404 and writes nothing.
# The gateway reports nothing back. What a node runs is observed on the bus and
# stays here (ADR-0029 d15; ADR-0022 d9) — `firmware_client.py once --dry-run`
# is what answers it.

# Where the release artifacts are cached (ADR-0029 d14). Empty = the service
# StateDirectory, /var/lib/industrygrow/firmware. Re-fetchable data, so it is the
# one thing ADR-0020 d5 costs nothing to lose.
IGROW_FIRMWARE_DIR=""

# Poll interval in seconds for `firmware_client.py serve`. The systemd TIMER is
# the production path and carries its own cadence (OnUnitInactiveSec=1h); change
# it with `systemctl edit industrygrow-firmware.timer`. This applies only to the
# in-process loop, for a host without timers.
IGROW_FIRMWARE_INTERVAL="3600"
IGROW_FIRMWARE_TIMEOUT="60"

# The client's own Cyphal Node-ID while a pass runs. It must differ from
# IGROW_CYPHAL_NODE_ID above and from the node range (96 up): the bootloader
# reads the artifact back from whichever node commanded the update, so this
# process is addressable for the whole transfer and two tools sharing an ID would
# take each other's responses.
IGROW_FIRMWARE_NODE_ID="3"

# How long one node may take to come back running the image it was served. The
# bootloader's own whole-transfer bound is 300 s; this is that plus the restart
# and bring-up either side of it. Raising it above the unit's TimeoutStartSec
# (3600) only means systemd kills the pass first.
IGROW_FIRMWARE_TRANSFER_TIMEOUT_S="420"

# --- Production egress target (ADR-0004 d5) — NOT applied at bring-up ---------
# Documentation only: when IndustryFlow exists (roadmap stage 11), this is the
# endpoint egress is locked to, alongside IGROW_ERP_URL — ADR-0004 d19 records
# that the production target is two named destinations, not one. Empty now;
# bring-up keeps egress open.
IGROW_INDUSTRYFLOW_ENDPOINT=""

# --- pip hash enforcement (see requirements.txt) -----------------------------
# Set to 1 after generating requirements.lock on the target arch.
IGROW_REQUIRE_HASHES="0"
