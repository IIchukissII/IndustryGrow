(version 1)

# U5 is an NCP114 in Package_DFN_QFN:OnSemi_XDFN4-1EP_1.0x1.0mm_EP0.52x0.52mm.
# The package places its pads 0.1324 mm apart, inside the 0.2 mm board default,
# so every pad of U5 collides with its exposed pad under the default rule. The
# spacing is library footprint geometry rather than a layout choice, so the pads
# of this one footprint are held to the fabricator minimum instead. The rule is
# scoped to U5 and does not relax clearance anywhere else on the board.
(rule "U5 intra-package pad clearance"
	(constraint clearance (min 0.13mm))
	(condition "A.memberOfFootprint('U5') && B.memberOfFootprint('U5')"))
